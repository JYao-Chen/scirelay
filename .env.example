# uv run --env-file .env ... loads a local .env; the library itself does not auto-load it.
MINERU_API_KEY=
# Configure deliberately; no implicit model default in the library.
# These example values follow the current SciEngine public interface page.
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
