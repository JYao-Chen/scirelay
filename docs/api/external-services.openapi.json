  "paths": {
    "/question": {
      "post": {
        "operationId": "science_research_question",
        "tags": [
          "SciEngine"
        ],
        "summary": "research_question",
        "description": "Upload service-adapted article.json. Client-observed contract, not provider-certified schema.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "LLM_MODEL",
                  "LLM_API_KEY",
                  "LLM_BASE_URL",
                  "file"
                ],
                "properties": {
                  "LLM_MODEL": {
                    "type": "string",
                    "example": "deepseek-v4-flash"
                  },
                  "LLM_API_KEY": {
                    "type": "string",
                    "writeOnly": true
                  },
                  "LLM_BASE_URL": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://api.deepseek.com"
                  },
                  "Stream": {
                    "type": "string",
                    "default": "False"
                  },
                  "extra_input": {
                    "type": "string",
                    "default": ""
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP success; still inspect business errors and content.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Error schema is not stable; preserve HTTP status and error text."
          }
        }
      }
    },
