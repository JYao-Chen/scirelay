    "/api/v4/file-urls/batch": {
      "post": {
        "servers": [
          {
            "url": "https://mineru.net"
          }
        ],
        "operationId": "mineru_create_batch",
        "tags": [
          "MinerU"
        ],
        "security": [
          {
            "MinerUBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "files"
                ],
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "data_id": {
                          "type": "string"
                        },
                        "is_ocr": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "model_version": {
                    "type": "string",
                    "examples": [
                      "vlm",
                      "pipeline"
                    ]
                  },
                  "enable_formula": {
                    "type": "boolean"
                  },
                  "enable_table": {
                    "type": "boolean"
                  },
                  "language": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Check code=0, then data.batch_id and data.file_urls."
          }
        }
      }
    },
    "/api/v4/extract-results/batch/{batch_id}": {
      "get": {
        "servers": [
          {
            "url": "https://mineru.net"
          }
        ],
        "operationId": "mineru_get_batch",
        "tags": [
          "MinerU"
        ],
        "security": [
          {
            "MinerUBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "batch_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Check code=0; data.extract_result contains per-file state and full_zip_url."
          }
        }
      }
    },
    "/chat/completions": {
      "post": {
        "servers": [
          {
            "url": "https://model.example.invalid/v1",
            "description": "Placeholder for the configured domain model; not a live service."
          }
        ],
        "operationId": "domain_chat",
        "tags": [
          "Domain LLM"
        ],
        "security": [
          {
            "ModelBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "configured-model"
                  },
                  "temperature": {
                    "type": "number",
                    "example": 0
                  },
                  "max_tokens": {
                    "type": "integer",
                    "examples": [
                      7000,
                      8192
                    ]
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string"
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read choices[0].message.content; reject finish_reason=length; parse content as JSON."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
