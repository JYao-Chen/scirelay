  "openapi": "3.1.0",
  "info": {
    "title": "SciEngine App integration — external services",
    "version": "2026-09-18",
    "description": "App-side documentation contract. No sample-project results. Not a provider-certified OpenAPI. The local App API is a separate design, not deployed."
  },
  "servers": [
    {
      "url": "https://sciengine.las.ac.cn"
    }
